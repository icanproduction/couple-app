# Copy to .env.local (local dev) or set in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are baked in at BUILD time — redeploy after changing them.
# Local dev with `supabase start` uses .env.development.local instead (see README).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Final public URL, no trailing slash (used for emails/links built on the server)
NEXT_PUBLIC_APP_URL=https://your-domain.example

# --- Web Push (generate once: npx web-push generate-vapid-keys) ---
# Keep the same pair across deploys, or every existing subscription breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact the push services can reach (mailto: or https:)
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduled jobs (Vercel Cron sends it as a Bearer token) ---
# Any long random string, e.g. `openssl rand -hex 32`
CRON_SECRET=your-random-secret

# --- AI: every AI feature (Daily Question, Date Ideas, Pet Kita, Samakan) ---
# Claude API key (sk-ant-...), read only by src/lib/claude.ts. Server only:
# never prefix with NEXT_PUBLIC_. The model is fixed to Claude Sonnet 5.5.
# Empty = every AI feature answers 503 "AI features aren't turned on yet" and
# nothing is sent. Set a monthly spend limit on the key in the Claude Console;
# per-couple daily caps live in AI_DAILY_CAP_USD (src/lib/claude.ts).
# Admin → AI (/admin/ai) shows the last 4 characters, today's spend and a
# Test connection button.
ANTHROPIC_API_KEY=
# Optional. "false" turns off the pet's daily AI note (templates are used instead).
# PET_AI_ENABLED=true

# --- Premium ---
# "true" = premium unlocks instantly without payment (QA / soft launch).
# Anything else (or unset) = unlock is disabled until a payment gateway is wired.
PAYMENT_DUMMY=false
