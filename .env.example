# Copy to .env.local (local dev) or set in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are baked in at BUILD time — redeploy after changing them.
# Local dev with `supabase start` uses .env.development.local instead (see README).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Final public URL, no trailing slash (used for emails/links built on the server)
NEXT_PUBLIC_APP_URL=https://your-domain.example

# --- Web Push (generate once: npx web-push generate-vapid-keys) ---
# Keep the same pair across deploys, or every existing subscription breaks.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact the push services can reach (mailto: or https:)
VAPID_SUBJECT=mailto:you@example.com

# --- Scheduled jobs (Vercel Cron sends it as a Bearer token) ---
# Any long random string, e.g. `openssl rand -hex 32`
CRON_SECRET=your-random-secret

# --- AI: Pertanyaan AI + Ide Date AI (GPT Luna via OpenRouter). Server only. ---
# OpenRouter API key (sk-or-v1-...). Never prefix with NEXT_PUBLIC_.
# Optional if the key is pasted in Admin → AI (/admin/ai): that one is stored in
# Supabase Vault and wins over this. Neither set = both features answer 503
# "Fitur AI belum diaktifkan" and nothing is sent.
# Local dev: paste it in ENV-PASTE.md and run `npm run env:paste`.
# Set a credit limit on the key in OpenRouter.
LLM_API_KEY=
# Optional. Default: https://openrouter.ai/api/v1 (any OpenAI-compatible endpoint works).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional. Default: openai/gpt-6-luna. Always an exact id, never a "~...-latest" alias.
# LLM_MODEL_SYNTHESIS=openai/gpt-6-luna

# --- Premium ---
# "true" = premium unlocks instantly without payment (QA / soft launch).
# Anything else (or unset) = unlock is disabled until a payment gateway is wired.
PAYMENT_DUMMY=false
